# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
build/
app/build/

# Gradle files
.gradle/

# Local configuration file (contains SDK path)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ IDEA
*.iml
.idea/

# Keystore files
*.jks
*.keystore

# Google Services
google-services.json

# External native build folder
.externalNativeBuild
.cxx

# OS generated files
.DS_Store
Thumbs.db

# Native shared libraries downloaded by download_opencv.sh
*.so
!app/src/main/jniLibs/*/.gitkeep

# Temporary archive downloads
*.zip
*.tar.gz
